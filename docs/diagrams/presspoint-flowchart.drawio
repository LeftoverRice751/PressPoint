        <mxCell id="knote" value="Every kiosk screen carries a Back control to the hub, and the 60 s idle timer runs on all of them.&#10;&#10;Static files (/storage/**, /assets/**) are served straight by nginx in production; VideoController@serve_storage is only the Python fallback on a miss." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FAFAF7;strokeColor=#9AA1AC;fontColor=#3A4048;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1400" width="280" height="200" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="ke1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B85;fontSize=10;fontColor=#3A4048;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry" /></mxCell>
