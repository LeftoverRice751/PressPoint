        <!-- Panel actions -->
        <mxCell id="A1" value="Read-only overview&lt;br&gt;articles by category,&lt;br&gt;recent articles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF8;strokeColor=#3C5C8D;fontColor=#12233F;fontSize=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="170" height="60" as="geometry" /></mxCell>

        <mxCell id="A2a" value="&lt;b&gt;POST /events/dashboard&lt;/b&gt;&lt;br&gt;publish an event" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="1340" width="170" height="55" as="geometry" /></mxCell>
        <mxCell id="A2b" value="&lt;b&gt;POST /events/dashboard/archive&lt;/b&gt;&lt;br&gt;extract events from a PDF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="1420" width="170" height="55" as="geometry" /></mxCell>

        <mxCell id="A3a" value="&lt;b&gt;POST /news/dashboard&lt;/b&gt;&lt;br&gt;create story + image&lt;br&gt;&lt;i&gt;.large/.thumb WebP derivatives&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="1340" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A3b" value="&lt;b&gt;POST /news/dashboard/layout&lt;/b&gt;&lt;br&gt;drop into a slot&lt;br&gt;&lt;i&gt;layout_type + ascending priority&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="1420" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A3c" value="&lt;b&gt;POST /news/dashboard/@id/body&lt;/b&gt;&lt;br&gt;Quill HTML → bleach allowlist&lt;br&gt;&lt;i&gt;kiosk renders it as HTML&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="1500" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A3d" value="&lt;b&gt;POST @id/unassign&lt;/b&gt; · &lt;b&gt;DELETE @id&lt;/b&gt;&lt;br&gt;&lt;i&gt;delete must remove derivatives&lt;br&gt;or they orphan forever&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="1580" width="170" height="65" as="geometry" /></mxCell>

        <mxCell id="A4a" value="&lt;b&gt;POST /archives/dashboard&lt;/b&gt;&lt;br&gt;upload PDF to the NAS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="1340" width="170" height="55" as="geometry" /></mxCell>
        <mxCell id="A4b" value="ArchiveServices (PyMuPDF)&lt;br&gt;cover + first 20 pages at 1.8x&lt;br&gt;&lt;i&gt;umask 0664/0775 for SMB&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="1420" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A4c" value="&lt;b&gt;DELETE /archives/dashboard/@id&lt;/b&gt;&lt;br&gt;&lt;i&gt;bump sw-archives CACHE_NAME&lt;br&gt;after replacing files&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="1500" width="170" height="65" as="geometry" /></mxCell>

        <mxCell id="A5a" value="Read-only in this build&lt;br&gt;&lt;b&gt;GET /api/locations&lt;/b&gt; only —&lt;br&gt;&lt;i&gt;no write route exists yet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF8;strokeColor=#3C5C8D;fontColor=#12233F;fontSize=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1340" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A5b" value="Coordinates are &lt;b&gt;pixels&lt;/b&gt;,&lt;br&gt;not WGS84 — lat=y, lng=x&lt;br&gt;in Leaflet CRS.Simple" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FAFAF7;strokeColor=#9AA1AC;fontColor=#3A4048;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="800" y="1420" width="170" height="70" as="geometry" /></mxCell>

        <mxCell id="A6a" value="&lt;b&gt;GET /org-board/dashboard/data&lt;/b&gt;&lt;br&gt;OrgBoardTree.build()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="990" y="1340" width="170" height="55" as="geometry" /></mxCell>
        <mxCell id="A6b" value="&lt;b&gt;store · update · move&lt;br&gt;photo · delete · reset-layout&lt;/b&gt;&lt;br&gt;drag a card onto another to nest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="990" y="1420" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A6c" value="&lt;b&gt;organization store / update / delete&lt;/b&gt;&lt;br&gt;&lt;i&gt;destroy refuses while members exist&lt;br&gt;(FK is ON DELETE CASCADE)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="990" y="1500" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="A6d" value="Fragment refresh re-emits the&lt;br&gt;organizations JSON block, so the&lt;br&gt;3 &amp;lt;select&amp;gt;s re-sync with no reload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF8;strokeColor=#3C5C8D;fontColor=#12233F;fontSize=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="1585" width="170" height="70" as="geometry" /></mxCell>

        <mxCell id="A7a" value="&lt;b&gt;POST /tour-scenes/dashboard&lt;/b&gt;&lt;br&gt;link a panorama to a building" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1180" y="1340" width="170" height="60" as="geometry" /></mxCell>

        <mxCell id="A8a" value="&lt;b&gt;GET /gears/about-lspu&lt;/b&gt;&lt;br&gt;&lt;i&gt;own editor page, not a tab&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="1340" width="170" height="55" as="geometry" /></mxCell>
        <mxCell id="A8b" value="&lt;b&gt;save_section/@slug&lt;/b&gt;&lt;br&gt;milestones create / update /&lt;br&gt;delete / reorder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="1420" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A8c" value="&lt;b&gt;seal/upload&lt;/b&gt; · &lt;b&gt;hymn/audio&lt;/b&gt;&lt;br&gt;→ NAS /About" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1370" y="1500" width="170" height="55" as="geometry" /></mxCell>

        <mxCell id="A9a" value="&lt;b&gt;POST /videos/dashboard&lt;/b&gt;&lt;br&gt;upload → NAS /Videos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1560" y="1340" width="170" height="55" as="geometry" /></mxCell>
        <mxCell id="A9b" value="&lt;b&gt;@id/idle&lt;/b&gt; · &lt;b&gt;@id/idle/clear&lt;/b&gt;&lt;br&gt;pick the attract-loop video&lt;br&gt;&lt;b&gt;DELETE @id&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1560" y="1420" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A9c" value="&lt;b&gt;POST /trigger-video&lt;/b&gt;&lt;br&gt;EditorialController@play_video&lt;br&gt;&lt;i&gt;_sanitize_video_src: /storage/ only&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1560" y="1500" width="170" height="65" as="geometry" /></mxCell>
        <mxCell id="A9d" value="Pusher &lt;b&gt;editorial&lt;/b&gt;&lt;br&gt;play-video → kiosk" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FCE7E4;strokeColor=#C0392B;fontColor=#5A1A12;fontSize=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="1585" width="170" height="55" as="geometry" /></mxCell>

        <mxCell id="A10a" value="&lt;b&gt;POST /kiosk/lock&lt;/b&gt;&lt;br&gt;&lt;b&gt;POST /kiosk/unlock&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1750" y="1340" width="170" height="55" as="geometry" /></mxCell>
        <mxCell id="A10b" value="Pusher &lt;b&gt;kiosk-channel&lt;/b&gt;&lt;br&gt;&lt;i&gt;best-effort: response reports&lt;br&gt;broadcast true/false&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FCE7E4;strokeColor=#C0392B;fontColor=#5A1A12;fontSize=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1750" y="1420" width="170" height="65" as="geometry" /></mxCell>

        <mxCell id="A11a" value="&lt;b&gt;POST /gears/branding/logo&lt;/b&gt;&lt;br&gt;&lt;b&gt;POST .../logo/restore&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1940" y="1340" width="170" height="55" as="geometry" /></mxCell>
        <mxCell id="A11b" value="Branding.set_logo()&lt;br&gt;&lt;i&gt;never write SiteSetting directly&lt;/i&gt;&lt;br&gt;site_logo() shared to all templates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1940" y="1420" width="170" height="70" as="geometry" /></mxCell>

        <!-- Common write path -->
        <mxCell id="wbox" value="Every editor write funnels through this path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA1AC;dashed=1;fontColor=#5A6B85;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="1760" width="800" height="560" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="Validate the upload by &lt;b&gt;magic bytes&lt;/b&gt;&lt;br&gt;FileVerificationService via ImageUploads.read_upload&lt;br&gt;&lt;i&gt;never trust the browser filename&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="1800" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;StorageRouter&lt;/b&gt;&lt;br&gt;first segment in NAS_FOLDERS&lt;br&gt;(Archives · Videos · About · Branding) → GearsNAS&lt;br&gt;otherwise → storage/framework/public&lt;br&gt;&lt;i&gt;is_safe_path() on every DB/user path&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="1890" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="Write the row (MySQL &lt;i&gt;presspoint&lt;/i&gt;)&lt;br&gt;&lt;i&gt;updated_at moves the section stamp&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F2E8F8;strokeColor=#7B3FA0;fontColor=#31123F;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="2005" width="280" height="75" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="AJAX request?&lt;br&gt;&lt;i&gt;wants_json()&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2D2;strokeColor=#B07E00;fontColor=#4A3600;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="2100" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="json_success / json_errors&lt;br&gt;&lt;i&gt;upload meter updates&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF8;strokeColor=#3C5C8D;fontColor=#12233F;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="2110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="redirect + flash message&lt;br&gt;&lt;i&gt;plain form post still degrades gracefully&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF8;strokeColor=#3C5C8D;fontColor=#12233F;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="2110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="&lt;b&gt;Kiosk shows the change&lt;/b&gt; on its next render&lt;br&gt;(or immediately, via a Pusher push)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#111827;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="2220" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dnote" value="Cross-cutting, on every request:&#10;&#10;· web middleware group — session, load user, CSRF (meta name=csrf-token in base.html)&#10;&#10;· DatabaseReconnectMiddleware clears the singleton QueryBuilder's cached MySQL connection, or REPEATABLE READ pins each gunicorn worker to a stale snapshot and editors keep seeing old data&#10;&#10;· server → client wiring is data-* attributes on a root element; page JS is plain IIFE / DOMContentLoaded, no framework" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FAFAF7;strokeColor=#9AA1AC;fontColor=#3A4048;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1800" width="380" height="300" as="geometry" />
        </mxCell>

