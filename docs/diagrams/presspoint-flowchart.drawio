        <mxCell id="ke3" value="No — keep looping" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B85;fontSize=10;fontColor=#3A4048;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3" target="k2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="330" /><mxPoint x="810" y="220" /></Array></mxGeometry></mxCell>
