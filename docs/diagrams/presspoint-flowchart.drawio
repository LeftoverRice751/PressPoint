  <diagram id="presspoint-gears" name="GEARS dashboard (editors)">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dtitle" value="PressPoint — GEARS CMS flow (authenticated editors)" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#111827;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dsub" value="Draft — generated from routes/auth.py, routes/dashboard.py, routes/super_admin.py and templates/gears/dashboard.html" style="text;html=1;fontSize=12;fontColor=#5A6B85;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1000" height="24" as="geometry" />
        </mxCell>

        <!-- Auth spine -->
        <mxCell id="d1" value="Editor opens presspoint-gears.me" style="ellipse;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#111827;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;GET /login&lt;/b&gt;&lt;br&gt;auth.LoginController@show" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;POST /login&lt;/b&gt;&lt;br&gt;middleware throttle:auth&lt;br&gt;&lt;i&gt;GuestAuthLimiter keys on CF-Connecting-IP&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="200" height="75" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Credentials valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2D2;strokeColor=#B07E00;fontColor=#4A3600;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="Rejected / rate-limited&lt;br&gt;back to the login form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF8;strokeColor=#3C5C8D;fontColor=#12233F;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="405" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="&lt;b&gt;GET /forgot-password&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="190" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;POST /forgot-password&lt;/b&gt;&lt;br&gt;send OTP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="265" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;POST /forgot-password/otp&lt;/b&gt;&lt;br&gt;throttle:auth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="345" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;GET / POST /change-password&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="425" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d6" value="Which role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2D2;strokeColor=#B07E00;fontColor=#4A3600;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="&lt;b&gt;superadmin&lt;/b&gt; → /auth/super_admin&lt;br&gt;create &amp;amp; delete admin accounts&lt;br&gt;&lt;i&gt;middleware auth, super_admin&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="520" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="&lt;b&gt;admin&lt;/b&gt; → /users&lt;br&gt;add / remove editors&lt;br&gt;&lt;i&gt;middleware auth, admin&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="520" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="&lt;b&gt;GET /gears/dashboard&lt;/b&gt;&lt;br&gt;DashboardController@show&lt;br&gt;&lt;i&gt;middleware auth&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d10" value="DashboardContext.full_context()&lt;br&gt;composes every panel's context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d11" value="&lt;b&gt;Tabbed shell renders&lt;/b&gt;&lt;br&gt;11 panels, one visible at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3D6B;strokeColor=#1F3D6B;fontColor=#ffffff;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Liveness loop -->
        <mxCell id="lbox" value="Dashboard liveness (dashboard-live.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA1AC;dashed=1;fontColor=#5A6B85;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="640" width="490" height="440" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="Poll every 20 s&lt;br&gt;&lt;b&gt;GET /gears/dashboard/stamps&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="690" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="Stamp moved?&lt;br&gt;&lt;i&gt;count : max(updated_at)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2D2;strokeColor=#B07E00;fontColor=#4A3600;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="790" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;GET /gears/dashboard/fragment/@section&lt;/b&gt;&lt;br&gt;re-renders the &lt;i&gt;same&lt;/i&gt; Jinja partial&lt;br&gt;the full page uses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="910" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="Swap HTML into data-live-target&lt;br&gt;&lt;i&gt;another editor's change appears&lt;br&gt;without a reload&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7EEF8;strokeColor=#3C5C8D;fontColor=#12233F;fontSize=11;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="1000" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="Lnote" value="Panels opt in with data-live-section / data-live-target.&#10;&#10;Live sections: events, archives, videos, news, org-board-organizations.&#10;&#10;news-canvas is fetched directly after a drawer assignment, never polled.&#10;&#10;Adding a section means adding to BOTH FRAGMENTS and STAMP_MODELS." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FAFAF7;strokeColor=#9AA1AC;fontColor=#3A4048;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="610" y="690" width="190" height="290" as="geometry" />
        </mxCell>

        <!-- Panel hub -->
        <mxCell id="hub" value="Editor picks a panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F3D6B;strokeColor=#1F3D6B;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="960" y="1140" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Panel tiles -->
        <mxCell id="P1" value="Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E5A9E;strokeColor=#2E5A9E;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="170" height="40" as="geometry" /></mxCell>
