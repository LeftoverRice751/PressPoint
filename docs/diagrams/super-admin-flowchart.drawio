        <mxCell id="s_d1" value="request.remove_user()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="1430" width="280" height="40" as="geometry"/></mxCell>
        <mxCell id="s_d2" value="response.delete_cookie(slot_cookie(&quot;token&quot;, slot))&#xa;— this is the half that actually ends the session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="1500" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="s_d3" value="clear_slot_session(request, response, slot)&#xa;(other tabs' sign-ins are untouched)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F1E8;strokeColor=#2E7D4F;fontColor=#123320;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="1580" width="280" height="50" as="geometry"/></mxCell>
