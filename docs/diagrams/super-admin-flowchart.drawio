        <mxCell id="n_c" value="Editors as well as admins appear in the table, so a super admin can remove either. news.author_id / updated_by_id are ON DELETE SET NULL, so the stories survive." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FAFAF7;strokeColor=#9AA1AC;fontColor=#3A4048;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="740" y="1900" width="280" height="90" as="geometry"/></mxCell>
