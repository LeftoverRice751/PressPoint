        <mxCell id="n_d" value="Guarded by &quot;auth&quot; alone on purpose: a session whose role was changed underneath it must still be able to sign out. Gating logout behind &quot;super_admin&quot; too would strand it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FAFAF7;strokeColor=#9AA1AC;fontColor=#3A4048;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1080" y="1740" width="280" height="100" as="geometry"/></mxCell>
