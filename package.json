{
  "private": true,
  "scripts": {
    "dev": "npm run development",
    "development": "node ./node_modules/laravel-mix/bin/cli.js",
    "watch": "node ./node_modules/laravel-mix/bin/cli.js watch",
    "watch-poll": "node ./node_modules/laravel-mix/bin/cli.js watch -- --watch-options-poll=1000",
    "hot": "node ./node_modules/laravel-mix/bin/cli.js watch --hot",
    "prod": "npm run production",
    "production": "node ./node_modules/laravel-mix/bin/cli.js --production"
  },
  "devDependencies": {
    "axios": "^1.15.0",
    "laravel-mix": "^6.0.3",
    "postcss": "^8.4.5"
  },
  "overrides": {
    "webpack": "5.60.0",
    "webpack-cli": "4.10.0",
    "webpack-dev-server": "4.7.3"
  }
}
